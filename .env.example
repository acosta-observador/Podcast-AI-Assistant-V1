# Chave da API da ElevenLabs (Scribe)
ELEVENLABS_API_KEY=
# Chave da API da Anthropic (Estrutura Plus: o Claude decide os sons e a música de cada cena)
ANTHROPIC_API_KEY=
# Palavra-passe única da equipa (o browser pede-a ao abrir o site). Vazio = sem proteção.
APP_PASSWORD=
# Onde ficam os episódios (tem de ser um disco persistente em produção)
DATA_DIR=./data
# Modelo do Scribe
SCRIBE_MODEL=scribe_v2
# Quantos episódios processar em paralelo
WORKERS=1
